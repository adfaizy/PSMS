# Normalize text files to LF in the repository (avoids LF/CRLF churn on Windows).
* text=auto eol=lf

# Binary — do not modify line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.otf binary
*.wasm binary
*.node binary
*.pdf binary
*.zip binary
